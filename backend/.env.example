# Server Environment
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# ─── Database Configuration ──────────────────────────────────────────────────
# Option A: Local MySQL / MariaDB (Default development)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pharmacare_db
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
DB_WAIT_FOR_CONNECTIONS=true
DB_SSL=false
# DB_CA_PATH=certs/isrgrootx1.pem

# Option B: TiDB Cloud Serverless (Production / Cloud)
# DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=your_tidb_username.root
# DB_PASSWORD=your_tidb_password_here
# DB_NAME=pharmacare
# DB_SSL=true
# DB_CA_PATH=certs/isrgrootx1.pem

# Security & Authentication
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_characters_long_for_security
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12

# CORS Whitelist (Frontend development URLs)
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
AUTH_RATE_LIMIT_MAX=15
INQUIRY_RATE_LIMIT_MAX=20

# SMTP Email Configuration (Nodemailer)
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false
# IMPORTANT: For Gmail, generate a 16-character App Password (Google Account > Security > 2-Step Verification > App Passwords)
# Never use your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM="PharmaCare Clinical Pharmacy" <noreply@pharmacare.pk>
PHARMACY_NOTIFICATION_EMAIL=dispensary@pharmacare.pk
