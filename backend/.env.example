# Server Environment
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# ─── Database Configuration ──────────────────────────────────────────────────
# Option A: Local MySQL / MariaDB (Default development)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pharmacare_db
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
DB_WAIT_FOR_CONNECTIONS=true
DB_SSL=false
# DB_CA_PATH=certs/isrgrootx1.pem

# Option B: TiDB Cloud Serverless (Production / Cloud)
# DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=your_tidb_username.root
# DB_PASSWORD=your_tidb_password_here
# DB_NAME=pharmacare
# DB_SSL=true
# DB_CA_PATH=certs/isrgrootx1.pem

# Security & Authentication
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_characters_long_for_security
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12

# CORS Whitelist (Frontend development URLs)
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
AUTH_RATE_LIMIT_MAX=15
INQUIRY_RATE_LIMIT_MAX=20

# SMTP Email Configuration (Nodemailer)
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false
# IMPORTANT: For Gmail, generate a 16-character App Password (Google Account > Security > 2-Step Verification > App Passwords)
# Never use your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM="PharmaCare Clinical Pharmacy" <noreply@pharmacare.pk>
PHARMACY_NOTIFICATION_EMAIL=dispensary@pharmacare.pk

# ─── Persistent Cloud Storage (Required for Render Free Production) ──────────
# 1. Cloudinary — Public doctor profile photos & public medical images
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_DOCTOR_FOLDER=pharmacare/doctors

# 2. Cloudflare R2 — Private prescription documents & sensitive uploads (NEVER public)
# Configure EITHER R2_ACCOUNT_ID or full R2_ENDPOINT
R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_PRIVATE_BUCKET=pharmacare-private-prescriptions
R2_PRESCRIPTION_PREFIX=prescriptions
# Short-lived presigned URL lifetime in seconds (clamped strictly to 30-300)
R2_SIGNED_URL_TTL_SECONDS=120

# Optional: Only set true if explicitly allowing local ephemeral disk in production (NOT recommended on Render Free)
# ALLOW_EPHEMERAL_UPLOADS=false
